# Production template. Put real values in the hosting provider's secret manager,
# not in this file and never in Git.
SECRET_KEY=generate-a-new-random-secret-for-this-environment
DEBUG=False
ALLOWED_HOSTS=quiz.example.it

DB_ENGINE=postgresql
DB_NAME=patentish
DB_USER=patentish_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_HOST=private-postgres-hostname
DB_PORT=5432
DB_SSLMODE=verify-full
DB_CONN_MAX_AGE=60

# Keep frontend and API on one origin if possible. Set these only for a
# deliberate split-origin setup; the current frontend uses same-origin cookies.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

SECURE_SSL_REDIRECT=True
# Set True only when the trusted reverse proxy overwrites X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

CACHE_TABLE=django_cache
# Set only when the reverse proxy overwrites X-Forwarded-For and the count of
# trusted proxy hops is known.
NUM_PROXIES=
SESSION_COOKIE_AGE=604800

# Optional; only needed by offline translation tooling.
DEEPL_AUTH_KEY=
